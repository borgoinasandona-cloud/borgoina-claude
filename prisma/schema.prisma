generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum Visibility {
  PUBLIC
  PRIVATE
  PENDING // in attesa di moderazione — usato dalla community, non dalla bacheca news admin
}

enum CommunityPostType {
  GIFT // regalo (gruppo "Oggetti")
  LOAN // presto (gruppo "Oggetti")
  REQUEST // chiedo (gruppo "Servizi e lavori")
  SALE // vendo (gruppo "Oggetti")
  SERVICE_OFFER // offro (gruppo "Servizi e lavori")
  // ISSUE e ANNOUNCEMENT: ritirati dalla community il 2026-07-20 (quel contenuto vive nella
  // bacheca news, Post) — valori lasciati nell'enum per non rompere Postgres (niente DROP VALUE
  // pulito), ma non più selezionabili/creabili da nessuna UI.
  ISSUE
  ANNOUNCEMENT
}

enum CommunityPostStatus {
  AVAILABLE
  PENDING
  CLOSED
}

enum CommentVisibility {
  PUBLIC
  AUTHOR_ONLY
}

enum ShopCategory {
  CRAFTS // artigianato
  SHOP // negozio/commercio
  FOOD // ristorazione/alimentari
  SERVICES // servizi
  OTHER
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  emailVerified  DateTime? // richiesto da @auth/prisma-adapter per gli utenti OAuth (Google)
  image          String? // avatar da provider OAuth, richiesto da @auth/prisma-adapter
  password       String? // hash bcrypt, null se solo OAuth
  name           String?
  role           Role            @default(MEMBER)
  accounts       Account[]
  sessions       Session[]
  communityPosts CommunityPost[]
  comments       Comment[]
  shop           Shop?
  createdAt      DateTime        @default(now())
}

// Account / Session / VerificationToken: modelli standard richiesti da Auth.js
// (@auth/prisma-adapter) per supportare provider OAuth (Google, Fase 2) accanto a Credentials
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Page {
  id        String   @id @default(cuid())
  slug      String   @unique // "il-borgo" | "chi-siamo" | "contatti"
  title     String
  content   String   @db.Text // HTML (editor WYSIWYG)
  updatedAt DateTime @updatedAt
}

model Post {
  id           String      @id @default(cuid())
  slug         String      @unique
  title        String
  excerpt      String?
  content      String      @db.Text // HTML (editor WYSIWYG)
  coverImage   String? // Cloudinary public_id
  externalLink String? // es. link galleria Google Photos
  publishedAt  DateTime?
  featured     Boolean     @default(false)
  visibility   Visibility  @default(PUBLIC)
  categories   Category[]
  images       PostImage[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

// Bacheca della community: iscritti pubblicano oggetti (regalo/prestito/cerco/vendo)
// e segnalazioni/eventi, separata dalla bacheca news (Post) gestita solo dall'admin.
model CommunityPost {
  id                   String               @id @default(cuid())
  slug                 String               @unique
  title                String
  content              String               @db.Text // HTML (editor WYSIWYG)
  coverImage           String? // Cloudinary public_id
  authorId             String
  author               User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  type                 CommunityPostType
  status               CommunityPostStatus?
  visibility           Visibility           @default(PENDING)
  visibilityOfComments CommentVisibility    @default(PUBLIC)
  comments             Comment[]
  featured             Boolean              @default(false)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
}

model Comment {
  id              String        @id @default(cuid())
  communityPostId String
  communityPost   CommunityPost @relation(fields: [communityPostId], references: [id], onDelete: Cascade)
  authorId        String
  author          User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content         String        @db.Text
  createdAt       DateTime      @default(now())
}

// Pagina di presentazione di un'attività/bottega di un iscritto: separata da CommunityPost
// (annunci) — un utente ne ha al massimo una (authorId @unique). Pubblicata subito, senza
// moderazione admin (a differenza degli annunci community): visibility resta nel modello solo
// per permettere all'admin di nascondere contenuti inappropriati a posteriori (PUBLIC/PRIVATE),
// PENDING non viene più usato qui.
//
// authorId è opzionale (2026-08-01): l'admin può creare una bottega per conto di un titolare che
// non si è ancora registrato come iscritto, inserendo ownerName come nome da mostrare in "Gestita
// da" finché non collega la bottega a un account reale — a quel punto author.name/image prendono
// il sopravvento (vedi la risoluzione in app/botteghe/[slug]/page.tsx). authorId resta @unique:
// più righe con authorId NULL sono ammesse da Postgres, il vincolo "una bottega per utente" si
// applica solo a quelle effettivamente collegate.
model Shop {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  category    ShopCategory

  // Sezione "Chi siamo"
  slogan      String? // frase corta, mostrata come tagline sotto il nome
  description String       @db.Text // "descrizione e servizi" — testo semplice, come CommunityPost.content (non HTML)
  history     String?      @db.Text // "da quanti anni esiste / storia"
  whyChooseUs String?      @db.Text // "perché sceglierci"

  // Sezione "Contatti"
  address     String?
  phone       String? // anche per il pulsante CTA WhatsApp in pubblico, non solo la chiamata
  email       String?
  website     String?
  instagram   String? // canale Instagram della bottega, distinto da siteConfig.instagramUrl (del comitato)
  hours       String?      @db.Text // "orari", testo libero multi-riga

  coverImage  String? // Cloudinary secure_url, come CommunityPost.coverImage
  ownerName   String? // nome del gestore inserito dall'admin, usato finché non c'è un account collegato
  authorId    String?      @unique // 1:1 opzionale — un utente ha al massimo una bottega
  author      User?        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  images      ShopImage[]
  visibility  Visibility   @default(PUBLIC)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model ShopImage {
  id     String  @id @default(cuid())
  shopId String
  shop   Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  url    String
  alt    String?
  order  Int     @default(0)
}

model Category {
  id    String @id @default(cuid())
  name  String @unique // "Eventi", "Feste"
  slug  String @unique
  posts Post[]
}

model PostImage {
  id     String  @id @default(cuid())
  postId String
  post   Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  url    String // Cloudinary
  alt    String?
  order  Int     @default(0)
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String   @db.Text
  createdAt DateTime @default(now())
}
